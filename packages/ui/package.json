{
  "name": "@plumario/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Componentes reutilizables de Plumario, del sistema de diseño (GuiaComponentes). Solo presentación: ni rutas ni dominio.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "figures": "node scripts/generate-figures.mjs",
    "posters": "node scripts/generate-poster-scenes.mjs",
    "regions": "node scripts/generate-region-map.mjs"
  },
  "dependencies": {
    "@plumario/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@expo-google-fonts/bricolage-grotesque": "*",
    "@expo-google-fonts/instrument-sans": "*",
    "@expo-google-fonts/instrument-serif": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
