# Dependencias
node_modules/

# Firebase: salidas locales que no deben versionarse
functions/lib
functions/dist/
.firebase/
firebase-debug*.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log

# Turbo
.turbo/

# Configuración de Firebase de las apps: se baja de la consola, nunca se versiona (en ninguna carpeta)
google-services.json
GoogleService-Info.plist
# Claves de cuentas de servicio (Admin SDK): dan acceso total al proyecto
*-firebase-adminsdk-*.json
service-account*.json

# Fuentes de datos con material de terceros (fotos del catálogo): se versiona lo derivado, no el original
data/sources/*.xlsx

# Variables de entorno: solo se versiona el ejemplo
.env
.env*.local
# Secretos de Functions para el emulador (la clave de Gemini); en producción van en Secret Manager
.secret.local

# Expo y Metro (cada app ignora además lo suyo)
.expo/
dist/
web-build/

# Sistema
.DS_Store
Thumbs.db
*.log
.emulator-data/

# Originales de Antigravity del piloto de stickers (PA-30): pesan; se versionan los recortados.
apps/mobile/assets/sticker-pilot/raw/
