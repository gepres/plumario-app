rules_version = '2';

// Modelo de datos de Plumario. Regla general: cada usuario lee lo suyo; lo que se gana (stickers,
// cromos, logros) y el resultado de un intercambio los escribe el servidor (Cloud Functions, con el
// Admin SDK, que no pasa por estas reglas). El cliente solo crea registros pendientes, pósteres y
// propuestas de intercambio, y edita su perfil.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function isShortText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }

    // Catálogo de especies por región: público y de solo lectura. No tiene datos personales, y la
    // app lo necesita antes de que haya sesión. Lo carga tools/species/seed.mjs.
    match /regions/{regionId} {
      allow read: if true;
      allow write: if false;

      match /species/{speciesId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /users/{uid} {
      // Perfil: nombre, usuario, región y privacidad (PerfilEditar, PerfilPrivacidad).
      // Los campos nuevos (ave favorita, nombre en lo compartido, IA, cambio de @usuario) pueden faltar
      // en perfiles creados antes.
      function validProfile(data) {
        return data.keys().hasOnly(['displayName', 'handle', 'regionId', 'favoriteSpeciesId', 'privacy', 'handleChangedAt', 'regionAlerts', 'notifications', 'createdAt'])
          && isShortText(data.displayName, 40)
          && data.handle is string && data.handle.matches('^[a-z0-9_.]{3,24}$')
          && isShortText(data.regionId, 40)
          && (data.get('favoriteSpeciesId', null) == null || isShortText(data.favoriteSpeciesId, 80))
          && (data.get('handleChangedAt', null) == null || data.handleChangedAt is timestamp)
          && (data.get('regionAlerts', []) is list && data.get('regionAlerts', []).size() <= 24)
          && data.privacy is map
          && data.privacy.keys().hasOnly(['saveLocation', 'albumVisibility', 'showName', 'improveAi'])
          && data.privacy.saveLocation is bool
          && data.privacy.albumVisibility in ['private', 'link', 'public']
          && data.privacy.get('showName', true) is bool
          && data.privacy.get('improveAi', false) is bool
          && (data.get('notifications', null) == null || validNotifications(data.notifications))
          && data.createdAt is timestamp;
      }
      // Perfil › Notificaciones: qué avisos quiere (logros, intercambios, regiones).
      function validNotifications(notifications) {
        return notifications is map
          && notifications.keys().hasOnly(['achievements', 'trades', 'regions'])
          && notifications.get('achievements', true) is bool
          && notifications.get('trades', true) is bool
          && notifications.get('regions', true) is bool;
      }
      // El @usuario tiene que estar reservado a su nombre en la misma escritura (handles/).
      function ownsHandle(handle) {
        return existsAfter(/databases/$(database)/documents/handles/$(handle))
          && getAfter(/databases/$(database)/documents/handles/$(handle)).data.uid == uid;
      }
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(request.resource.data) && ownsHandle(request.resource.data.handle);
      // Cambiar el @usuario: una vez cada 30 días, con el nuevo reservado en la misma escritura y la
      // fecha del cambio en el perfil. Si no cambia, la fecha tampoco.
      function handleChangeAllowed() {
        return ownsHandle(request.resource.data.handle)
          && request.resource.data.handleChangedAt == request.time
          && (resource.data.get('handleChangedAt', null) == null
            || request.time > resource.data.handleChangedAt + duration.value(30, 'd'));
      }
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.handle == resource.data.handle
          ? request.resource.data.get('handleChangedAt', null) == resource.data.get('handleChangedAt', null)
          : handleChangeAllowed());
      allow delete: if isOwner(uid);

      // Registros: el cliente crea uno pendiente con su foto; una Cloud Function lo valida y cambia el
      // estado. La ubicación y el lugar son opcionales y solo los ve su dueño; en una especie
      // amenazada no se guardan nunca.
      match /sightings/{sightingId} {
        function isThreatened(data) {
          return get(/databases/$(database)/documents/regions/$(data.regionId)/species/$(data.speciesId)).data.get('threatened', false) == true;
        }
        function validSighting(data) {
          return data.keys().hasOnly(['speciesId', 'regionId', 'takenAt', 'status', 'photoPath', 'location', 'placeName', 'createdAt'])
            && isShortText(data.speciesId, 80)
            && isShortText(data.regionId, 40)
            && data.takenAt is timestamp
            && data.createdAt is timestamp
            && data.status == 'pending'
            && data.photoPath is string && data.photoPath.matches('^users/' + uid + '/photos/[^/]+$')
            && (data.location == null || (data.location is map
              && data.location.keys().hasOnly(['latitude', 'longitude'])
              && data.location.latitude is number && data.location.longitude is number))
            && (data.get('placeName', null) == null || isShortText(data.placeName, 60))
            && (!isThreatened(data) || (data.location == null && data.get('placeName', null) == null));
        }
        // Tampoco se borran desde la app: el registro es la prueba de lo que se otorgó. Al eliminar la
        // cuenta los borra el servidor.
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validSighting(request.resource.data);
        allow update, delete: if false;
      }

      // Stickers y cromos: solo el servidor.
      match /stickers/{speciesId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Logros: los otorga el servidor; el cliente solo marca que ya vio la celebración.
      match /achievements/{achievementId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanges(['seen']) && request.resource.data.seen == true;
        allow create, delete: if false;
      }

      // Pósteres guardados: el usuario elige mezcla, fondo y título (PosterGenerar, PosterVista).
      match /posters/{posterId} {
        function validPoster(data) {
          return data.keys().hasOnly(['kind', 'number', 'habitat', 'speciesIds', 'seed', 'theme', 'title', 'savedAt'])
            && data.kind in ['species', 'habitat']
            && data.speciesIds is list && data.speciesIds.size() <= 120
            && data.seed is int
            && data.theme in ['light', 'dark']
            && isShortText(data.title, 60)
            && data.savedAt is timestamp;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPoster(request.resource.data);
      }

      // Los teléfonos de la cuenta, para mandarles avisos (FCM): el id es el token del teléfono. El
      // dueño lo registra al activar las notificaciones y lo borra al cerrar sesión; el servidor
      // borra los que ya no sirven.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Reserva de @usuarios: cada uno es único y se lee de a uno (para ver si está libre antes de crear
    // la cuenta y para encontrar a alguien al intercambiar), pero no se pueden listar.
    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_.]{3,24}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      // Se libera al cambiar de @usuario: solo su dueño y en la misma escritura en que su perfil deja de usarlo.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle != handle;
    }

    // Comentarios (PerfilComentario): los escribe quien tiene sesión, a su nombre; los lee el equipo
    // desde la consola. Nadie los cambia.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'text', 'replyTo', 'screenshotPath', 'appVersion', 'platform', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['idea', 'error', 'bird', 'other']
        && isShortText(request.resource.data.text, 500)
        && (request.resource.data.replyTo == null || isShortText(request.resource.data.replyTo, 200))
        && (request.resource.data.screenshotPath == null || isShortText(request.resource.data.screenshotPath, 200))
        && isShortText(request.resource.data.appVersion, 20)
        && isShortText(request.resource.data.platform, 20)
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // Propuestas de intercambio: las crea quien ofrece y se comparten por enlace o QR. El id es
    // aleatorio y hace de llave: cualquiera con sesión que lo tenga puede leerla, pero solo se listan
    // las propias. Aceptar lo hace una Cloud Function en una transacción; quien propone solo puede
    // cancelarla. Su @usuario va en la propuesta (es público) y tiene que ser el de su perfil.
    match /trades/{tradeId} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromHandle', 'offeredSpeciesId', 'requestedSpeciesId', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromHandle == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle
        && isShortText(request.resource.data.offeredSpeciesId, 80)
        && isShortText(request.resource.data.requestedSpeciesId, 80)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn() && resource.data.fromUid == request.auth.uid
        && resource.data.status == 'open' && onlyChanges(['status']) && request.resource.data.status == 'cancelled';
      allow delete: if false;

      // Aceptar: quien abre el enlace deja su pedido y la función responde en el mismo documento
      // (result). Solo mientras siga abierta y no es la propia.
      match /acceptances/{acceptanceId} {
        allow get: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && get(/databases/$(database)/documents/trades/$(tradeId)).data.status == 'open'
          && get(/databases/$(database)/documents/trades/$(tradeId)).data.fromUid != request.auth.uid;
        allow list, update, delete: if false;
      }
    }

    // Todo lo demás se deniega.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
