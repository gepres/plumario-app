# Copia este archivo como .env (no se versiona). Expo lo lee al empaquetar: solo las variables
# EXPO_PUBLIC_ llegan a la app, y son públicas por diseño (nunca pongas secretos aquí).

# De dónde salen los datos de la app: memory (muestra del diseño), emulator o firebase.
# Con emulator: pnpm emulators y pnpm species:seed en la raíz; al cambiarla, reinicia pnpm dev.
EXPO_PUBLIC_DATA_SOURCE=memory

# Host de los emuladores de Firebase visto desde el teléfono. 10.0.2.2 es la máquina anfitriona
# desde el emulador de Android; con un teléfono físico, la IP de la máquina en la red.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
