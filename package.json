{
  "name": "plumario",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @plumario/mobile start",
    "android": "pnpm --filter @plumario/mobile android",
    "web": "pnpm --filter @plumario/mobile web",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "bundle-check": "turbo bundle-check",
    "check": "turbo lint type-check test && node scripts/check-architecture.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "tokens": "pnpm --filter @plumario/tokens generate",
    "icons": "pnpm --filter @plumario/mobile icons",
    "viewer": "node tools/viewer/build.mjs",
    "viewer:serve": "node tools/viewer/serve.mjs",
    "emulators": "pnpm functions:build && node scripts/firebase-emulators.mjs",
    "emulators:export": "firebase emulators:export .emulator-data --project demo-plumario --force",
    "functions:build": "pnpm --filter @plumario/functions build",
    "species:convert": "node tools/species/convert.mjs",
    "species:seed": "node tools/species/seed.mjs",
    "species:measures": "node tools/species/measures.mjs",
    "species:cards": "node tools/species/card-facts.mjs",
    "stickers:export": "python tools/stickers/build-review.py && python tools/stickers/export-art.py",
    "test:rules": "node scripts/firebase-emulators.mjs emulators:exec --only firestore,storage \"pnpm --filter @plumario/firebase test:rules\"",
    "dev:stickers": "node tools/dev/seed-stickers.mjs",
    "dev:trade": "node tools/dev/seed-trade.mjs"
  },
  "devDependencies": {
    "exceljs": "4.4.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
